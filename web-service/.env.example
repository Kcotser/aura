# =============================================================================
# AURA BACKEND — ENVIRONMENT VARIABLES REFERENCE
# Copy this file to .env (never commit .env)
# =============================================================================

# --- MongoDB Atlas ---
# Full Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=aura_prod

# --- JWT Security ---
# Base64-encoded secret, minimum 256 bits (32 bytes)
# Generate with: openssl rand -base64 32
JWT_SECRET=<base64-encoded-secret-min-256-bits>
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://app.aura.com

# --- Logging ---
LOG_LEVEL=INFO

# --- Analysis Context (reserved — not yet used by IAM) ---
# Anti-Corruption Layer for Gemma 4 integration
GEMMA_API_URL=
GEMMA_API_KEY=

# --- Privacy Context (reserved — not yet used by IAM) ---
# AES-256 key for field-level encryption of sensitive evidence metadata
FIELD_ENCRYPTION_KEY=
